# What ship needs to know about flower: its release, and its CI. Everything not
# stated here is ship's default — the manifest, the changelog path, the cliff
# config, and that this is a Cargo workspace.
name = flower
url = https://github.com/diaryx-org/flower
release_branch = main

# No `verify`: before cutting, a release runs the jobs below.

# The app's marketing version follows the workspace version, and no manifest
# parser in ship reaches an Xcode setting — so the bump runs the task that
# writes it, and the file is staged with the release commit. The `app-version`
# CI job checks they agree.
post_bump = cargo xtask sync-versions
extra_version_files = [apps/flower-editor/project.yml]

# Not on crates.io: flower is consumed from git, by commit, so a tag is a name
# for a commit and the start of whatever else is listed below.
publishes = false

# What pushing the tag sets off, most consequential first. The warning printed
# before the push is handed back to you is composed from these.
tag_starts
> *
> > workflow = homebrew.yml
> > does = builds the `flower` CLI binaries and writes the tap formula

# CI. `.github/workflows/ci.yml` asks `ship ci --matrix` for these and runs one
# per runner, as `ship ci <id>`; `ship ci` runs them all here, in this order,
# with the same shell, and stops at the first that fails. Changing CI is an edit
# here and nowhere else.
#
# A job is `id` (what `ship ci <id>` takes), `name` (the check GitHub shows as
# `CI / <name>` — renaming it renames the required status check) and `run` (run
# by `bash -eo pipefail -c` at the repository root). `runner` is the workflow's:
# `components` are the rustup components it installs, and `builds = false`
# skips restoring the cargo cache. Cheapest and most likely to fail first.
#
# The Swift half of flower (`packages/flower-swift`, `apps/flower-editor`) is
# mostly not here: compiling it needs macOS and Xcode, and
# `scripts/check-swift.sh` and `scripts/test-swift.sh` are run by hand on a Mac.
# `bindings` and `app-version` are the exceptions that fit a Linux runner.
job
> *
> > id = fmt
> > name = Format
> > run = cargo fmt --all --check
> > runner
> > > components = rustfmt
> > > builds = false
> *
> > # Warnings are errors in CI, so they are errors here too — a lint that only
> > # fires on the runner is a lint found too late.
> > id = clippy
> > name = Clippy
> > run = cargo clippy --workspace --all-targets -- -D warnings
> > runner
> > > components = clippy
> *
> > id = test
> > name = Test
> > run = cargo test --workspace
> *
> > # Workspace feature unification means `cargo check --workspace` can pass
> > # even when a crate cannot compile on its own. This builds each crate alone;
> > # the list is in xtask, beside the test that fails when a new member is left
> > # out of it.
> > id = package-isolation
> > name = Package isolation
> > run = cargo xtask package-isolation
> *
> > # The Swift package's UniFFI binding is committed, so it can go stale
> > # against `crates/flower-ffi`. The script regenerates it from the crate's
> > # embedded metadata and diffs; the output is arch-neutral source, so no
> > # Swift is compiled and a Linux runner will do.
> > id = bindings
> > name = Swift bindings
> > run = bash scripts/gen-bindings.sh --check
> *
> > # apps/flower-editor/project.yml states the workspace version. Reads one
> > # file and compiles nothing but xtask, so no cache.
> > id = app-version
> > name = App version
> > run = cargo xtask app-version
> > runner
> > > builds = false
> *
> > # The Dioxus widget and its app, each a workspace of its own (an alpha
> > # Dioxus; the app's winit-appkit is the patched one from the Blitz fork,
> > # by git), so nothing above reaches them. Compiles Blitz and wgpu: the slowest job.
> > id = dioxus
> > name = Dioxus widget and app
> > run = cargo fmt --manifest-path crates/flower-dioxus/Cargo.toml --check && cargo clippy --manifest-path crates/flower-dioxus/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path crates/flower-dioxus/Cargo.toml && cargo fmt --manifest-path apps/flower-dioxus/Cargo.toml --check && cargo clippy --manifest-path apps/flower-dioxus/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path apps/flower-dioxus/Cargo.toml
> > runner
> > > components = rustfmt, clippy
> *
> > # A build, not a test run: MSRV is a promise about who can compile flower,
> > # and the dev-dependencies need not hold to it. The version is read from
> > # `[workspace.package] rust-version`, so the pin follows the declared floor.
> > # `rustup run` rather than `cargo +<version>`, which only rustup's proxy knows.
> > id = msrv
> > name = MSRV
> > run = '''
version=$(sed -n 's/^rust-version = "\(.*\)"$/\1/p' Cargo.toml)
test -n "$version" || { echo "no rust-version in Cargo.toml" >&2; exit 1; }
echo "MSRV from Cargo.toml: $version"
rustup toolchain install "$version" --profile minimal --no-self-update
rustup run "$version" cargo build --workspace
'''
